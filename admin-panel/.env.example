# ===== 数据库（host 网络模式下走本机 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wangjiahui
DB_PASSWORD=
DB_NAME=telegram_bot

# ===== 初始管理员（仅首次迁移时创建，之后改这里无效）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRES=7d

# ===== Telegram API 代理（后端容器访问 api.telegram.org）=====
# 服务器同机 Clash：http://127.0.0.1:9980
TG_PROXY=http://127.0.0.1:9980

# 以下由 docker-compose.prod.yml 固定，一般无需设置
# PORT=10001
# API_BASE_PATH=/server/api

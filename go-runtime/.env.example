# botd environment variables — placeholders only, no real secrets.
# Values must match the server config/global.php for DB credentials.

# HTTP/WS listen address (host network; bound to loopback).
BOTD_LISTEN=127.0.0.1:19090

# MySQL connection.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# Timezone.
TZ=Asia/Shanghai

# Log level: debug | info | error.
LOG_LEVEL=info

# Reconcile / control-queue intervals (seconds).
RECONCILE_INTERVAL=30
CONTROL_POLL_INTERVAL=1

# Allow direct Telegram connection without a proxy (debug only; default false).
ALLOW_DIRECT=false

# Shared JWT secret with the Node backend (HS256). Required for /ws.
JWT_SECRET=<JWT_SECRET>

# Set to "off" to disable WS authentication (debug only; never in production).
#WS_AUTH=off

# Cutover whitelist: comma-separated bot names; empty runs all active bots.
#BOTD_ONLY=bot1

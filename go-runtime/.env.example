# botd 生产环境变量（占位符模板，不含真实凭据）
# 取值须与服务器 config/global.php 保持一致；实际文件由部署时填写，勿提交真实值。

# HTTP/WS 监听（host 网络，绑回环；nginx 8881 /ws 反代到此）
BOTD_LISTEN=127.0.0.1:<BOTD_PORT>

# MySQL（同机，host 网络直通回环）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# WS JWT 验签（与 Node 后端同一 secret）
JWT_SECRET=<JWT_SECRET>

# 运行
TZ=Asia/Shanghai
LOG_LEVEL=info
RECONCILE_INTERVAL=30
CONTROL_POLL_INTERVAL=1

# 割接期限定只运行 bot1（逗号分隔白名单；空=全部 active bot）
BOTD_ONLY=bot1

# 安全：默认禁止无代理直连 Telegram；仅非生产调试置 true
ALLOW_DIRECT=false

# WS 鉴权总开关（生产必须为 on；纯内网调试可 off）
WS_AUTH=on
